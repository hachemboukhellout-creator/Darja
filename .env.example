# Load explicitly: node --env-file=.env server/index.js
# npm scripts do not automatically load this file.
NODE_ENV=development
PORT=3001
DATABASE_PATH=./data/commerce.sqlite
ENABLE_DEMO=true

# Required when NODE_ENV=production. Use your actual public HTTPS origin.
# APP_ORIGIN=https://app.example.dz
# Disable demo access for a live store: ENABLE_DEMO=false
